pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                echo 'Checkout Stage'
            }
        }
        stage('Build') {
            steps {
                dir('spring-boot-app') {
                    sh 'mvn clean package'
                }
            }
        }
        stage('Test') {
            steps {
                dir('spring-boot-app') {
                    sh 'mvn test'
                }
            }
        }
        stage('Archive JAR') {
            steps {
                archiveArtifacts artifacts: 'spring-boot-app/target/*.jar', fingerprint: true
            }
        }
        stage('SonarQube Analysis') {
            steps {
                dir('spring-boot-app') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }
    }
    post {
        success {
            echo 'Build completed successfully.'
        }
        failure {
            echo 'Build failed.'
        }
    }
}